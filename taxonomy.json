        "id": "sole-discretion",
        "pattern": "(sole|absolute|unfettered)\\s+discretion",
        "delta": 8,
        "reason": "Decision power rests entirely with one party"
      },
      {
        "id": "without-notice",
        "pattern": "without\\s+(prior\\s+)?(notice|consent)",
        "delta": 8,
        "reason": "No notice or consent required"
      },
      {
        "id": "irrevocable-perpetual",
        "pattern": "\\b(irrevocabl[ey]|perpetual|in\\s+perpetuity)\\b",
        "delta": 5,
        "reason": "Obligation cannot be ended"
      },
      {
        "id": "notwithstanding",
        "pattern": "notwithstanding\\s+anything",
        "delta": 5,
        "reason": "Overrides other protective clauses"
      },
      {
        "id": "any-and-all",
        "pattern": "any\\s+and\\s+all",
        "delta": 3,
        "reason": "Very broad scope language"
      },
      {
        "id": "mutual",
        "pattern": "\\b(mutual(ly)?|each\\s+party|either\\s+party|neither\\s+party)\\b",
        "delta": -8,
        "reason": "Obligation runs both ways"
      },
      {
        "id": "reasonable",
        "pattern": "\\b(commercially\\s+)?reasonabl[ey]\\b",
        "delta": -4,
        "reason": "Reasonableness standard limits discretion"
      },
      {
        "id": "written-signed",
        "pattern": "in\\s+writing\\s+(and\\s+)?signed\\s+by\\s+(both|each|all)",
        "delta": -8,
        "reason": "Changes require signed writing by both sides"
      },
      {
        "id": "notice-period",
        "pattern": "\\b(30|thirty|60|sixty|90|ninety)\\s+days['’]?\\s+(prior\\s+)?(written\\s+)?notice",
        "delta": -5,
        "reason": "Defined advance notice period"
