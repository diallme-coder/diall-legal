      "definition": "Clause is common or limited in effect but worth noting for awareness or clarification.",
      "score_range": [
        1,
        39
      ]
    }
  },
  "scoring": {
    "base": "each rule has base_score; modifiers add or subtract points",
    "method": "score = base_score + sum(aggravator deltas matched in the clause) + mitigator_delta (once, if any mitigator matches) + sum(global modifier deltas matched in the clause); clamp to 1-100; map to severity_rubric. Scores rank review priority only and are not predictions of enforceability or outcome.",
